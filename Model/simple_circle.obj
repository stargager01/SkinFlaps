# Simple Circle with subdivided top surface for surgery simulation
# Material 2 = top surface (main skin), Material 1 = sides (periferal), Material 7 = bottom (periosteal)

# Top surface vertices - center + 2 rings (19 vertices, indices 1-19)
# Center (1)
v 0.0 0.0 1.0
# Inner ring radius 1.0 (2-7)
v 1.0 0.0 1.0
v 0.5 0.866 1.0
v -0.5 0.866 1.0
v -1.0 0.0 1.0
v -0.5 -0.866 1.0
v 0.5 -0.866 1.0
# Outer ring radius 2.0 (8-13)
v 2.0 0.0 1.0
v 1.0 1.732 1.0
v -1.0 1.732 1.0
v -2.0 0.0 1.0
v -1.0 -1.732 1.0
v 1.0 -1.732 1.0

# Bottom surface vertices - center + outer ring only (7 vertices, indices 14-20)
v 0.0 0.0 -0.5
v 2.0 0.0 -0.5
v 1.0 1.732 -0.5
v -1.0 1.732 -0.5
v -2.0 0.0 -0.5
v -1.0 -1.732 -0.5
v 1.0 -1.732 -0.5

# Texture coordinates for top (13)
vt 0.5 0.5
vt 0.75 0.5
vt 0.625 0.716
vt 0.375 0.716
vt 0.25 0.5
vt 0.375 0.284
vt 0.625 0.284
vt 1.0 0.5
vt 0.75 0.933
vt 0.25 0.933
vt 0.0 0.5
vt 0.25 0.067
vt 0.75 0.067
# Texture coordinates for bottom (7)
vt 0.5 0.5
vt 1.0 0.5
vt 0.75 0.933
vt 0.25 0.933
vt 0.0 0.5
vt 0.25 0.067
vt 0.75 0.067

# Top surface (material 2 - skin) - 18 triangles total, CCW
usemtl 2
s 1
# Inner fan (6 triangles)
f 1/1 2/2 3/3
f 1/1 3/3 4/4
f 1/1 4/4 5/5
f 1/1 5/5 6/6
f 1/1 6/6 7/7
f 1/1 7/7 2/2
# Outer ring (12 triangles connecting inner to outer)
f 2/2 8/8 9/9
f 2/2 9/9 3/3
f 3/3 9/9 10/10
f 3/3 10/10 4/4
f 4/4 10/10 11/11
f 4/4 11/11 5/5
f 5/5 11/11 12/12
f 5/5 12/12 6/6
f 6/6 12/12 13/13
f 6/6 13/13 7/7
f 7/7 13/13 8/8
f 7/7 8/8 2/2

# Bottom surface (material 7 - periosteal) - 6 triangles, CW from above
usemtl 7
s 2
f 14/14 16/16 15/15
f 14/14 17/17 16/16
f 14/14 18/18 17/17
f 14/14 19/19 18/18
f 14/14 20/20 19/19
f 14/14 15/15 20/20

# Side walls (material 1 - periferal) - 12 triangles
usemtl 1
s 3
f 8/8 15/15 16/16
f 8/8 16/16 9/9
f 9/9 16/16 17/17
f 9/9 17/17 10/10
f 10/10 17/17 18/18
f 10/10 18/18 11/11
f 11/11 18/18 19/19
f 11/11 19/19 12/12
f 12/12 19/19 20/20
f 12/12 20/20 13/13
f 13/13 20/20 15/15
f 13/13 15/15 8/8
