# Simple Prism - hexagonal prism for testing
# Material 2 = top surface (main skin), Material 1 = sides (periferal), Material 7 = bottom (periosteal)

# Top surface center (1)
v 0.0 0.0 1.0
# Top hexagon (2-7)
v 2.0 0.0 1.0
v 1.0 1.732 1.0
v -1.0 1.732 1.0
v -2.0 0.0 1.0
v -1.0 -1.732 1.0
v 1.0 -1.732 1.0

# Bottom surface center (8)
v 0.0 0.0 -0.5
# Bottom hexagon (9-14)
v 2.0 0.0 -0.5
v 1.0 1.732 -0.5
v -1.0 1.732 -0.5
v -2.0 0.0 -0.5
v -1.0 -1.732 -0.5
v 1.0 -1.732 -0.5

# Texture coordinates
vt 0.5 0.5
vt 1.0 0.5
vt 0.75 0.933
vt 0.25 0.933
vt 0.0 0.5
vt 0.25 0.067
vt 0.75 0.067
vt 0.5 0.5
vt 1.0 0.5
vt 0.75 0.933
vt 0.25 0.933
vt 0.0 0.5
vt 0.25 0.067
vt 0.75 0.067

# Top surface (material 2 - skin) - CCW
usemtl 2
s 1
f 1/1 2/2 3/3
f 1/1 3/3 4/4
f 1/1 4/4 5/5
f 1/1 5/5 6/6
f 1/1 6/6 7/7
f 1/1 7/7 2/2

# Bottom surface (material 7 - periosteal) - CW
