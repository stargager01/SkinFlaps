# Simple Box with subdivided top surface for surgery simulation
# Material 2 = top surface (main skin), Material 1 = sides (periferal), Material 7 = bottom (periosteal)

# Top surface vertices - 5x5 grid (25 vertices, indices 1-25)
v -2.0 -2.0 1.0
v -1.0 -2.0 1.0
v 0.0 -2.0 1.0
v 1.0 -2.0 1.0
v 2.0 -2.0 1.0
v -2.0 -1.0 1.0
v -1.0 -1.0 1.0
v 0.0 -1.0 1.0
v 1.0 -1.0 1.0
v 2.0 -1.0 1.0
v -2.0 0.0 1.0
v -1.0 0.0 1.0
v 0.0 0.0 1.0
v 1.0 0.0 1.0
v 2.0 0.0 1.0
v -2.0 1.0 1.0
v -1.0 1.0 1.0
v 0.0 1.0 1.0
v 1.0 1.0 1.0
v 2.0 1.0 1.0
v -2.0 2.0 1.0
v -1.0 2.0 1.0
v 0.0 2.0 1.0
v 1.0 2.0 1.0
v 2.0 2.0 1.0

# Bottom surface vertices - perimeter matching top (16 vertices, indices 26-41)
# Front edge (y = -2): 26-30
v -2.0 -2.0 -0.5
v -1.0 -2.0 -0.5
v 0.0 -2.0 -0.5
v 1.0 -2.0 -0.5
v 2.0 -2.0 -0.5
# Right edge (x = 2): 31-33 (skip corners already defined)
v 2.0 -1.0 -0.5
v 2.0 0.0 -0.5
v 2.0 1.0 -0.5
# Back edge (y = 2): 34-38
v 2.0 2.0 -0.5
v 1.0 2.0 -0.5
v 0.0 2.0 -0.5
v -1.0 2.0 -0.5
v -2.0 2.0 -0.5
# Left edge (x = -2): 39-41
v -2.0 1.0 -0.5
v -2.0 0.0 -0.5
v -2.0 -1.0 -0.5

# Texture coordinates
vt 0.0 0.0
vt 0.25 0.0
vt 0.5 0.0
vt 0.75 0.0
vt 1.0 0.0
vt 0.0 0.25
vt 0.25 0.25
vt 0.5 0.25
vt 0.75 0.25
vt 1.0 0.25
vt 0.0 0.5
vt 0.25 0.5
vt 0.5 0.5
vt 0.75 0.5
vt 1.0 0.5
vt 0.0 0.75
vt 0.25 0.75
vt 0.5 0.75
vt 0.75 0.75
vt 1.0 0.75
vt 0.0 1.0
vt 0.25 1.0
vt 0.5 1.0
vt 0.75 1.0
vt 1.0 1.0
vt 0.0 0.0
vt 0.25 0.0
vt 0.5 0.0
vt 0.75 0.0
vt 1.0 0.0
vt 1.0 0.25
vt 1.0 0.5
vt 1.0 0.75
vt 1.0 1.0
vt 0.75 1.0
vt 0.5 1.0
vt 0.25 1.0
vt 0.0 1.0
vt 0.0 0.75
vt 0.0 0.5
vt 0.0 0.25

# Top surface (material 2 - skin) - 32 triangles, CCW
usemtl 2
s 1
f 1/1 2/2 7/7
f 1/1 7/7 6/6
f 2/2 3/3 8/8
f 2/2 8/8 7/7
f 3/3 4/4 9/9
f 3/3 9/9 8/8
f 4/4 5/5 10/10
f 4/4 10/10 9/9
f 6/6 7/7 12/12
f 6/6 12/12 11/11
f 7/7 8/8 13/13
f 7/7 13/13 12/12
f 8/8 9/9 14/14
f 8/8 14/14 13/13
f 9/9 10/10 15/15
f 9/9 15/15 14/14
f 11/11 12/12 17/17
f 11/11 17/17 16/16
f 12/12 13/13 18/18
f 12/12 18/18 17/17
f 13/13 14/14 19/19
f 13/13 19/19 18/18
f 14/14 15/15 20/20
f 14/14 20/20 19/19
f 16/16 17/17 22/22
f 16/16 22/22 21/21
f 17/17 18/18 23/23
f 17/17 23/23 22/22
f 18/18 19/19 24/24
f 18/18 24/24 23/23
f 19/19 20/20 25/25
f 19/19 25/25 24/24

# Bottom surface (material 7 - periosteal) - 14 triangles forming perimeter ring, CW
usemtl 7
s 2
f 26/26 30/30 27/27
f 27/27 30/30 28/28
f 28/28 30/30 29/29
f 30/30 34/34 31/31
f 31/31 34/34 32/32
f 32/32 34/34 33/33
f 34/34 38/38 35/35
f 35/35 38/38 36/36
f 36/36 38/38 37/37
f 38/38 26/26 39/39
f 39/39 26/26 40/40
f 40/40 26/26 41/41
f 26/26 38/38 34/34
f 26/26 34/34 30/30

# Side walls (material 1 - periferal) - 32 triangles
usemtl 1
s 3
# Front (y = -2): top 1-5, bottom 26-30
f 1/1 26/26 27/27
f 1/1 27/27 2/2
f 2/2 27/27 28/28
f 2/2 28/28 3/3
f 3/3 28/28 29/29
f 3/3 29/29 4/4
f 4/4 29/29 30/30
f 4/4 30/30 5/5
# Right (x = 2): top 5,10,15,20,25, bottom 30,31,32,33,34
f 5/5 30/30 31/31
f 5/5 31/31 10/10
f 10/10 31/31 32/32
f 10/10 32/32 15/15
f 15/15 32/32 33/33
f 15/15 33/33 20/20
f 20/20 33/33 34/34
f 20/20 34/34 25/25
# Back (y = 2): top 25,24,23,22,21, bottom 34,35,36,37,38
f 25/25 34/34 35/35
f 25/25 35/35 24/24
f 24/24 35/35 36/36
f 24/24 36/36 23/23
f 23/23 36/36 37/37
f 23/23 37/37 22/22
f 22/22 37/37 38/38
f 22/22 38/38 21/21
# Left (x = -2): top 21,16,11,6,1, bottom 38,39,40,41,26
f 21/21 38/38 39/39
f 21/21 39/39 16/16
f 16/16 39/39 40/40
f 16/16 40/40 11/11
f 11/11 40/40 41/41
f 11/11 41/41 6/6
f 6/6 41/41 26/26
f 6/6 26/26 1/1
