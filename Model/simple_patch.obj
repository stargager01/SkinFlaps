# Simple Box - minimal closed volume for testing
# Material 2 = top surface (main skin), Material 1 = sides (periferal), Material 7 = bottom (periosteal)

# Top surface vertices (z = 1.0)
v -2.0 -2.0 1.0
v 2.0 -2.0 1.0
v 2.0 2.0 1.0
v -2.0 2.0 1.0

# Bottom surface vertices (z = -0.5)
v -2.0 -2.0 -0.5
v 2.0 -2.0 -0.5
v 2.0 2.0 -0.5
v -2.0 2.0 -0.5

# Texture coordinates
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Top surface (material 2 - skin) - CCW when viewed from above
usemtl 2
s 1
f 1/1 2/2 3/3
f 1/1 3/3 4/4

# Bottom surface (material 7 - periosteal) - CW when viewed from above
usemtl 7
s 2
f 5/5 7/7 6/6
f 5/5 8/8 7/7

# Side walls (material 1 - periferal)
usemtl 1
s 3
# Front (y = -2)
f 1/1 5/5 6/6
f 1/1 6/6 2/2
# Right (x = 2)
f 2/2 6/6 7/7
f 2/2 7/7 3/3
# Back (y = 2)
f 3/3 7/7 8/8
f 3/3 8/8 4/4
# Left (x = -2)
f 4/4 8/8 5/5
f 4/4 5/5 1/1
