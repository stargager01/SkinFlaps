# Simple Patch with radial top surface for surgery simulation
# Material 2 = top surface (main skin), Material 1 = sides (periferal), Material 7 = bottom (periosteal)

# Top surface vertices - center + 2 rings (17 vertices, indices 1-17)
# Center (1)
v 0.0 0.0 1.0
# Inner ring radius ~1.0 - 8 points (2-9)
v 1.0 0.0 1.0
v 1.0 1.0 1.0
v 0.0 1.0 1.0
v -1.0 1.0 1.0
v -1.0 0.0 1.0
v -1.0 -1.0 1.0
v 0.0 -1.0 1.0
v 1.0 -1.0 1.0
# Outer ring radius ~2.0 - 8 points (10-17)
v 2.0 0.0 1.0
v 2.0 2.0 1.0
v 0.0 2.0 1.0
v -2.0 2.0 1.0
v -2.0 0.0 1.0
v -2.0 -2.0 1.0
v 0.0 -2.0 1.0
v 2.0 -2.0 1.0

# Bottom surface vertices - center + outer ring (9 vertices, indices 18-26)
v 0.0 0.0 -0.5
v 2.0 0.0 -0.5
v 2.0 2.0 -0.5
v 0.0 2.0 -0.5
v -2.0 2.0 -0.5
v -2.0 0.0 -0.5
v -2.0 -2.0 -0.5
v 0.0 -2.0 -0.5
v 2.0 -2.0 -0.5

# Texture coordinates (26)
vt 0.5 0.5
vt 0.75 0.5
vt 0.75 0.75
vt 0.5 0.75
vt 0.25 0.75
vt 0.25 0.5
vt 0.25 0.25
vt 0.5 0.25
vt 0.75 0.25
vt 1.0 0.5
vt 1.0 1.0
vt 0.5 1.0
vt 0.0 1.0
vt 0.0 0.5
vt 0.0 0.0
vt 0.5 0.0
vt 1.0 0.0
vt 0.5 0.5
vt 1.0 0.5
vt 1.0 1.0
vt 0.5 1.0
vt 0.0 1.0
vt 0.0 0.5
vt 0.0 0.0
vt 0.5 0.0
vt 1.0 0.0

# Top surface (material 2 - skin) - 24 triangles total, CCW
usemtl 2
s 1
# Inner fan from center (8 triangles)
f 1/1 2/2 3/3
f 1/1 3/3 4/4
f 1/1 4/4 5/5
f 1/1 5/5 6/6
f 1/1 6/6 7/7
f 1/1 7/7 8/8
f 1/1 8/8 9/9
f 1/1 9/9 2/2
# Outer ring (16 triangles connecting inner to outer)
f 2/2 10/10 11/11
f 2/2 11/11 3/3
f 3/3 11/11 12/12
f 3/3 12/12 4/4
f 4/4 12/12 13/13
f 4/4 13/13 5/5
f 5/5 13/13 14/14
f 5/5 14/14 6/6
f 6/6 14/14 15/15
f 6/6 15/15 7/7
f 7/7 15/15 16/16
f 7/7 16/16 8/8
f 8/8 16/16 17/17
f 8/8 17/17 9/9
f 9/9 17/17 10/10
f 9/9 10/10 2/2

# Bottom surface (material 7 - periosteal) - 8 triangles, CW from above
usemtl 7
s 2
f 18/18 20/20 19/19
f 18/18 21/21 20/20
f 18/18 22/22 21/21
f 18/18 23/23 22/22
f 18/18 24/24 23/23
f 18/18 25/25 24/24
f 18/18 26/26 25/25
f 18/18 19/19 26/26

# Side walls (material 1 - periferal) - 16 triangles
usemtl 1
s 3
f 10/10 19/19 20/20
f 10/10 20/20 11/11
f 11/11 20/20 21/21
f 11/11 21/21 12/12
f 12/12 21/21 22/22
f 12/12 22/22 13/13
f 13/13 22/22 23/23
f 13/13 23/23 14/14
f 14/14 23/23 24/24
f 14/14 24/24 15/15
f 15/15 24/24 25/25
f 15/15 25/25 16/16
f 16/16 25/25 26/26
f 16/16 26/26 17/17
f 17/17 26/26 19/19
f 17/17 19/19 10/10
